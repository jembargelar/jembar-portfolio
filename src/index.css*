:root {
  --bg-color: #0f172a;
  --card-bg: #1e293b;
  --text-color: #f8fafc;
  --text-muted: #94a3b8;
  --primary: #38bdf8;
  --primary-hover: #0284c7;
  --border-color: #334155;
  --font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  scroll-behavior: smooth;
}

body {
  background-color: var(--bg-color);
  color: var(--text-color);
  font-family: var(--font-family);
  line-height: 1.6;
}

.section {
  max-width: 900px;
  margin: 0 auto;
  padding: 80px 20px 20px;
}

h2 {
  font-size: 2rem;
  margin-bottom: 24px;
  color: var(--primary);
  border-bottom: 2px solid var(--border-color);
  display: inline-block;
  padding-bottom: 6px;
}

p {
  color: var(--text-muted);
  margin-bottom: 16px;
  font-size: 1.05rem;
}

strong {
  color: var(--text-color);
}

/* Navbar */
.navbar {
  position: fixed;
  top: 0;
  width: 100%;
  background: rgba(15, 23, 42, 0.9);
  backdrop-filter: blur(10px);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 8%;
  z-index: 1000;
  border-bottom: 1px solid var(--border-color);
}

.logo {
  font-weight: 700;
  font-size: 1.3rem;
  color: var(--primary);
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 20px;
}

.nav-links a {
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.3s;
  font-size: 0.95rem;
}

.nav-links a:hover {
  color: var(--primary);
}

/* Hero */
.hero {
  min-height: 75vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 120px 20px 40px;
}

.hero h1 {
  font-size: 2.5rem;
  margin-bottom: 12px;
}

.hero h1 span {
  color: var(--primary);
}

.hero p {
  font-size: 1.15rem;
  margin-bottom: 24px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.hero-btns {
  display: flex;
  gap: 16px;
  justify-content: center;
}

.btn {
  padding: 10px 22px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  display: inline-block;
  transition: all 0.3s ease;
}

.btn.primary {
  background-color: var(--primary);
  color: #0f172a;
}

.btn.primary:hover {
  background-color: var(--primary-hover);
}

.btn.secondary {
  border: 1px solid var(--border-color);
  color: var(--text-color);
}

.btn.secondary:hover {
  background-color: var(--card-bg);
}

/* Cards */
.card {
  background-color: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 20px;
  transition: transform 0.3s ease, border-color 0.3s ease;
}

.card:hover {
  transform: translateY(-4px);
  border-color: var(--primary);
}

.card h3 {
  font-size: 1.25rem;
  margin-bottom: 4px;
}

.card h4 {
  color: var(--primary);
  font-size: 1rem;
  margin-bottom: 8px;
  font-weight: 500;
}

.card small {
  color: var(--text-muted);
  display: block;
  margin-bottom: 12px;
}

.tech-tag {
  color: var(--primary) !important;
  font-weight: 500;
  margin-top: 8px;
}

/* Skills */
.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.skill {
  background-color: var(--card-bg);
  border: 1px solid var(--border-color);
  padding: 8px 18px;
  border-radius: 20px;
  font-size: 0.9rem;
  color: var(--primary);
}

/* Contact Section */
.contact-links {
  display: flex;
  gap: 16px;
  margin-top: 16px;
}

/* Footer */
.footer {
  text-align: center;
  padding: 30px;
  margin-top: 40px;
  border-top: 1px solid var(--border-color);
  color: var(--text-muted);
  font-size: 0.9rem;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .nav-links {
    display: none;
  }
  .hero h1 {
    font-size: 1.9rem;
  }
  .section {
    padding-top: 60px;
  }
}
